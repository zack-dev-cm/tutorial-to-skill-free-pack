NEXT_PUBLIC_SITE_URL=https://tutorial-to-skill-free-pack.vercel.app

# Vercel Marketplace Redis / Upstash storage for opted-in subscriber emails.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend email delivery.
RESEND_API_KEY=
EMAIL_FROM="Tutorial-to-Skill <updates@example.com>"

# Shared secret required by POST /api/notify.
UPDATE_WEBHOOK_SECRET=

# Used to sign unsubscribe links. Keep stable across deployments.
UNSUBSCRIBE_SECRET=
